<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The CarPlay audio entitlement, kept OUT of Runner.entitlements until Apple
  grants it to the team (a signed build with an entitlement the profile does
  not carry fails to install). Merge it in with:

    ruby tools/apple/carplay.rb enable

  See docs/CARPLAY.md.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
