# Copy to .env locally. Never commit the real .env or SMTP credentials.
DATABASE_URL=sqlite:///./training.db
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
SITE_URL=https://train.altibyan.app
VERSES_PATH=./data/verses.json
MEDIA_DIR=./media

# Outbound SMTP for contact-form notifications (Resend).
# Add the Resend API key only to the private server .env, never to this file.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Tibyan Training <no-reply@train.altibyan.app>
SMTP_TO=

# Web Push (VAPID). Generate on the server with `python -m app.vapid`
# and append the two lines to the private .env only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://train.altibyan.app

# Training runner (the Mac). A long random token, only in the server .env
# and the Mac's ~/.config/tibyan-runner/env. Empty = runner API disabled.
RUNNER_TOKEN=

# Public model mirror (host directory mounted into the container).
MIRROR_DIR=./mirror
MIRROR_BASE_URL=https://tibyan.ahmedhelal.dev/mirror/recitation-models
MODEL_NAME=nvidia-ar-fastconformer-ctc
