<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget: today's khatma portion (KhatmaWidgetProvider). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/khatma_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/khatma_widget_background"
    android:gravity="center_vertical"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/khatma_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#B8923E"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/khatma_portion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:textColor="#F4EEDD"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/khatma_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#C9D4CC"
        android:textSize="13sp" />
</LinearLayout>
