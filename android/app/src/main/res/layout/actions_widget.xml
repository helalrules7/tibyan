<?xml version="1.0" encoding="utf-8"?>
<!-- Actions widget (ActionsWidgetProvider): four buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/khatma_widget_background"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/actions_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="4dp"
        android:textColor="#B8923E"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/action_continue"
            style="@style/ActionsButton">
            <ImageView
                style="@style/ActionsIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_action_book" />
            <TextView
                style="@style/ActionsLabel"
                android:text="@string/actions_continue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_listen"
            style="@style/ActionsButton">
            <ImageView
                style="@style/ActionsIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_action_play" />
            <TextView
                style="@style/ActionsLabel"
                android:text="@string/actions_listen" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_search"
            style="@style/ActionsButton">
            <ImageView
                style="@style/ActionsIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_action_search" />
            <TextView
                style="@style/ActionsLabel"
                android:text="@string/actions_search" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_done"
            style="@style/ActionsButton">
            <ImageView
                android:id="@+id/action_done_icon"
                style="@style/ActionsIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_action_check" />
            <TextView
                android:id="@+id/action_done_label"
                style="@style/ActionsLabel"
                android:text="@string/actions_read" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
