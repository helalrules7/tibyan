{"id":"warsh","name_ar":"ورش عن نافع","name_en":"Warsh from Nafi","pages":604,"grid":[26.7,35.229],"opening":[[[12.82,-104.44,225.87,226.7],[4.0,34.0,234.0,234.0]],[[8.34,-103.12,229.87,227.3],[2.0,31.0,234.0,234.0]]],"font":"uthmanic_warsh_v21.ttf","surahs":[[7,1],[285,2],[200,50],[175,77],[122,106],[167,128],[206,151],[76,177],[130,187],[109,208],[121,221],[111,235],[44,249],[54,255],[99,262],[128,267],[110,282],[105,293],[99,305],[134,312],[111,322],[76,332],[119,342],[62,350],[77,359],[226,367],[95,377],[88,385],[69,396],[59,404],[33,411],[30,415],[73,418],[54,428],[46,434],[82,440],[182,446],[86,453],[72,458],[84,467],[53,477],[50,483],[89,489],[56,496],[36,499],[34,502],[39,507],[29,511],[18,515],[45,518],[60,520],[47,523],[61,526],[55,528],[77,531],[99,534],[28,537],[21,542],[24,545],[13,549],[14,551],[11,553],[11,554],[18,556],[12,558],[12,560],[31,562],[52,564],[52,566],[44,568],[30,570],[28,572],[18,574],[55,575],[39,577],[31,578],[50,580],[40,582],[45,583],[42,585],[29,586],[19,587],[36,587],[25,589],[22,590],[17,591],[19,591],[26,592],[32,593],[20,594],[15,595],[21,595],[11,596],[8,596],[8,597],[20,597],[5,598],[8,598],[9,599],[11,599],[10,600],[8,600],[3,601],[9,601],[5,601],[5,602],[6,602],[3,602],[6,603],[3,603],[5,603],[4,604],[5,604],[6,604]],"verses":[[1,1,1,1,2,2,"اِ۬لْحَمْدُ لِلهِ رَبِّ اِ۬لْعَٰلَمِينَ ﰀ"],[1,2,1,1,3,3,"اَ۬لرَّحْمَٰنِ اِ۬لرَّحِيمِ ﰁ"],[1,3,1,1,4,4,"مَلِكِ يَوْمِ اِ۬لدِّينِۖ ﰂ"],[1,4,1,1,5,5,"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُۖ ﰃ"],[1,5,1,1,6,6,"اُ۪هْدِنَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَ ﰄ"],[1,6,1,1,7,7,"صِرَٰطَ اَ۬لذِينَ أَنْعَمْتَ عَلَيْهِمْ ﰅ"],[1,7,1,1,7,7,"غَيْرِ اِ۬لْمَغْضُوبِ عَلَيْهِمْ وَلَا اَ۬لضَّآلِّينَۖ ﰆ"],[2,1,2,1,1,2,"أَلَٓمِّٓۖ ذَٰلِكَ اَ۬لْكِتَٰبُ لَا رَيْبَۖ فِيهِ هُدىٗ لِّلْمُتَّقِينَ ﰀ"],[2,2,2,1,3,3,"اَ۬لذِينَ يُومِنُونَ بِالْغَيْبِ وَيُقِيمُونَ اَ۬لصَّلَوٰةَ وَمِمَّا رَزَقْنَٰهُمْ يُنفِقُونَۖ ﰁ"],[2,3,2,1,4,4,"وَالذِينَ يُومِنُونَ بِمَآ أُنزِلَ إِلَيْكَ وَمَآ أُنزِلَ مِن قَبْلِكَ وَبِالَاخِرَةِ هُمْ يُوقِنُونَ ﰂ"],[2,4,2,1,5,5,"أُوْلَٰٓئِكَ عَلَىٰ هُدىٗ مِّن رَّبِّهِمْۖ وَأُوْلَٰٓئِكَ هُمُ اُ۬لْمُفْلِحُونَۖ ﰃ"],[2,5,3,1,6,6,"إِنَّ اَ۬لذِينَ كَفَرُواْ سَوَآءٌ عَلَيْهِمُۥٓ ءَآنذَرْتَهُمُۥٓ أَمْ لَمْ تُنذِرْهُمْ لَا يُومِنُونَۖ ﰄ"],[2,6,3,1,7,7,"خَتَمَ اَ۬للَّهُ عَلَىٰ قُلُوبِهِمْ وَعَلَىٰ سَمْعِهِمْۖ وَعَلَىٰٓ أَبْصٰ۪رِهِمْ غِشَٰوَةٞۖ وَلَهُمْ عَذَابٌ عَظِيمٞۖ ﰅ"],[2,7,3,1,8,8,"وَمِنَ اَ۬لنَّاسِ مَنْ يَّقُولُ ءَامَنَّا بِاللَّهِ وَبِالْيَوْمِ اِ۬لَاخِرِ وَمَا هُم بِمُومِنِينَۖ ﰆ"],[2,8,3,1,9,9,"يُخَٰدِعُونَ اَ۬للَّهَ وَالذِينَ ءَامَنُواْۖ وَمَا يُخَٰدِعُونَ إِلَّآ أَنفُسَهُمْ وَمَا يَشْعُرُونَۖ ﰇ"],[2,9,3,1,10,10,"فِے قُلُوبِهِم مَّرَضٞۖ فَزَادَهُمُ اُ۬للَّهُ مَرَضاٗۖ وَلَهُمْ عَذَابٌ اَلِيمُۢ بِمَا كَانُواْ يُكَذِّبُونَۖ ﰈ"],[2,10,3,1,11,11,"وَإِذَا قِيلَ لَهُمْ لَا تُفْسِدُواْ فِے اِ۬لَارْضِ قَالُوٓاْ إِنَّمَا نَحْنُ مُصْلِحُونَۖ ﰉ"],[2,11,3,1,12,12,"أَلَآ إِنَّهُمْ هُمُ اُ۬لْمُفْسِدُونَ وَلَٰكِن لَّا يَشْعُرُونَۖ ﰊ"],[2,12,3,1,13,13,"وَإِذَا قِيلَ لَهُمُۥٓ ءَامِنُواْ كَمَآ ءَامَنَ اَ۬لنَّاسُ قَالُوٓاْ أَنُومِنُ كَمَآ ءَامَنَ اَ۬لسُّفَهَآءُۖ اَ۬لَآ إِنَّهُمْ هُمُ اُ۬لسُّفَهَآءُ وَلَٰكِن لَّا يَعْلَمُونَۖ ﰋ"],[2,13,3,1,14,14,"وَإِذَا لَقُواْ اُ۬لذِينَ ءَامَنُواْ قَالُوٓاْ ءَامَنَّاۖ وَإِذَا خَلَوِاْ اِلَىٰ شَيَٰطِينِهِمْ قَالُوٓاْ إِنَّا مَعَكُمُۥٓ إِنَّمَا نَحْنُ مُسْتَهْزِءُونَۖ ﰌ"],[2,14,3,1,15,15,"اَ۬للَّهُ يَسْتَهْزِۓُ بِهِمْ وَيَمُدُّهُمْ فِے طُغْيَٰنِهِمْ يَعْمَهُونَۖ ﰍ"],[2,15,3,1,16,16,"أُوْلَٰٓئِكَ اَ۬لذِينَ اَ۪شْتَرَوُاْ اُ۬لضَّلَٰلَةَ بِالْهُد۪ىٰ فَمَا رَبِحَت تِّجَٰرَتُهُمْ وَمَا كَانُواْ مُهْتَدِينَۖ ﰎ"],[11,71,230,12,72,72,"قَالَتْ يَٰوَيْلَت۪ىٰٓ ءَالِدُ وَأَنَا عَجُوزٞ وَهَٰذَا بَعْلِے شَيْخاًۖ اِنَّ هَٰذَا لَشَےْءٌ عَجِيبٞۖ ﱆ"],[11,72,230,12,73,73,"۞ قَالُوٓاْ أَتَعْجَبِينَ مِنَ اَمْرِ اِ۬للَّهِۖ رَحْمَتُ اُ۬للَّهِ وَبَرَكَٰتُهُۥ عَلَيْكُمُۥٓ أَهْلَ اَ۬لْبَيْتِۖ إِنَّهُۥ حَمِيدٞ مَّجِيدٞۖ ﱇ"],[11,73,230,12,74,74,"فَلَمَّا ذَهَبَ عَنِ اِبْرَٰهِيمَ اَ۬لرَّوْعُ وَجَآءَتْهُ اُ۬لْبُشْر۪ىٰ يُجَٰدِلُنَا فِے قَوْمِ لُوطٍۖ ﱈ"],[11,74,230,12,75,75,"اِنَّ إِبْرَٰهِيمَ لَحَلِيمٌ اَوَّٰهٞ مُّنِيبٞۖ ﱉ"],[11,75,230,12,76,76,"يَٰٓإِبْرَٰهِيمُ أَعْرِضْ عَنْ هَٰذَآۖ إِنَّهُۥ قَدْ جَآءَ امْرُ رَبِّكَۖ وَإِنَّهُمُۥٓ ءَاتِيهِمْ عَذَابٌ غَيْرُ مَرْدُودٖۖ ﱊ"],[11,76,230,12,77,77,"وَلَمَّا جَآءَتْ رُسُلُنَا لُوطاٗ س۬ےٓءَ بِهِمْ وَضَاقَ بِهِمْ ذَرْعاٗ وَقَالَ هَٰذَا يَوْمٌ عَصِيبٞۖ ﱋ"],[11,77,230,12,78,78,"وَجَآءَهُۥ قَوْمُهُۥ يُهْرَعُونَ إِلَيْهِ وَمِن قَبْلُ كَانُواْ يَعْمَلُونَ اَ۬لسَّيِّـَٔاتِۖ قَالَ يَٰقَوْمِ هَٰٓؤُلَآءِ بَنَاتِے هُنَّ أَطْهَرُ لَكُمْ فَاتَّقُواْ اُ۬للَّهَ وَلَا تُخْزُونِ فِے ضَيْفِيَۖ أَلَيْسَ مِنكُمْ رَجُلٞ رَّشِيدٞۖ ﱌ"],[11,78,230,12,79,79,"قَالُواْ لَقَدْ عَلِمْتَ مَا لَنَا فِے بَنَاتِكَ مِنْ حَقّٖ وَإِنَّكَ لَتَعْلَمُ مَا نُرِيدُۖ ﱍ"],[11,79,230,12,80,80,"قَالَ لَوَ اَنَّ لِے بِكُمْ قُوَّةً اَوَ اٰوِےٓ إِلَىٰ رُكْنٖ شَدِيدٖۖ ﱎ"],[11,80,230,12,81,81,"قَالُواْ يَٰلُوطُ إِنَّا رُسُلُ رَبِّكَ لَنْ يَّصِلُوٓاْ إِلَيْكَۖ فَاسْرِ بِأَهْلِكَ بِقِطْعٖ مِّنَ اَ۬ليْلِ وَلَا يَلْتَفِتْ مِنكُمُۥٓ أَحَدٌ اِلَّا اَ۪مْرَأَتَكَۖ إِنَّهُۥ مُصِيبُهَا مَآ أَصَابَهُمُۥٓۖ إِنَّ مَوْعِدَهُمُ اُ۬لصُّبْحُۖ أَلَيْسَ اَ۬لصُّبْحُ بِقَرِيبٖۖ ﱏ"],[11,81,231,12,82,82,"فَلَمَّا جَآءَ امْرُنَا جَعَلْنَا عَٰلِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهَا حِجَارَةٗ مِّن سِجِّيلٖ ﱐ"],[11,82,231,12,82,83,"مَّنضُودٖ مُّسَوَّمَةً عِندَ رَبِّكَۖ وَمَا هِيَ مِنَ اَ۬لظَّٰلِمِينَ بِبَعِيدٖۖ ﱑ"],[11,83,231,12,84,84,"۞ وَإِلَىٰ مَدْيَنَ أَخَاهُمْ شُعَيْباٗۖ قَالَ يَٰقَوْمِ اِ۟عْبُدُواْ اُ۬للَّهَ مَا لَكُم مِّنِ اِلَٰهٍ غَيْرُهُۥۖ وَلَا تَنقُصُواْ اُ۬لْمِكْيَالَ وَالْمِيزَانَۖ إِنِّيَ أَر۪يٰكُم بِخَيْرٖ وَإِنِّيَ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٖ مُّحِيطٖۖ ﱒ"],[11,84,231,12,85,85,"وَيَٰقَوْمِ أَوْفُواْ اُ۬لْمِكْيَالَ وَالْمِيزَانَ بِالْقِسْطِۖ وَلَا تَبْخَسُواْ اُ۬لنَّاسَ أَشْيَآءَهُمْ وَلَا تَعْثَوْاْ فِے اِ۬لَارْضِ مُفْسِدِينَۖ ﱓ"],[11,85,231,12,86,86,"بَقِيَّتُ اُ۬للَّهِ خَيْرٞ لَّكُمُۥٓ إِن كُنتُم مُّومِنِينَۖ ﱔ"],[11,86,231,12,86,86,"وَمَآ أَنَا عَلَيْكُم بِحَفِيظٖۖ ﱕ"],[11,87,231,12,87,87,"قَالُواْ يَٰشُعَيْبُ أَصَلَوَٰتُكَ تَامُرُكَ أَن نَّتْرُكَ مَا يَعْبُدُ ءَابَآؤُنَآ أَوَ اَن نَّفْعَلَ فِےٓ أَمْوَٰلِنَا مَا نَشَٰٓؤُاْۖ اِ۪نَّكَ لَأَنتَ اَ۬لْحَلِيمُ اُ۬لرَّشِيدُۖ ﱖ"],[11,88,231,12,88,88,"قَالَ يَٰقَوْمِ أَرَٰٓيْتُمُۥٓ إِن كُنتُ عَلَىٰ بَيِّنَةٖ مِّن رَّبِّے وَرَزَقَنِے مِنْهُ رِزْقاً حَسَناٗۖ وَمَآ أُرِيدُ أَنُ ا۟خَالِفَكُمُۥٓ إِلَىٰ مَآ أَنْه۪يٰكُمْ عَنْهُۖ إِنُ ا۟رِيدُ إِلَّا اَ۬لِاصْلَٰحَ مَا اَ۪سْتَطَعْتُۖ وَمَا تَوْفِيقِيَ إِلَّا بِاللَّهِۖ عَلَيْهِ تَوَكَّلْتُۖ وَإِلَيْهِ أُنِيبُۖ ﱗ"]],"polygons":[[1,1,1,"213,38 66,38 66,70 213,70",74.58,53.85],[1,1,2,"66,38 25,38 25,70 225,70 225,102 168,102 168,70 66,70",177.03,86.06],[1,1,3,"168,70 55,70 55,102 168,102",64.17,85.13],[1,1,4,"55,70 8,70 8,102 230,102 230,132 55,132",67.29,117.27],[1,1,5,"55,102 8,102 8,132 225,132 225,164 93,164 93,132 55,132",102.93,148.88],[1,1,6,"93,132 15,132 15,164 208,164 208,196 110,196 110,164 93,164",121.38,180.91],[1,1,7,"110,164 28,164 28,196 185,196 185,230 60,230 60,196 110,196",71.86,210.88],[2,2,1,"210,35 30,35 30,70 230,70 230,102 174,102 174,70 210,70",182.24,83.59],[2,2,2,"174,70 8,70 8,102 230,102 230,132 111,132 111,102 174,102",119.56,114.97],[2,2,3,"111,102 8,102 8,132 230,132 230,164 6,164 6,132 111,132",14.93,147.88],[2,2,4,"210,164 28,164 28,196 165,196 165,230 70,230 70,196 210,196",78.28,212.79],[3,2,5,"M 8.0 2.0 L 339.0 2.0 L 339.0 47.25 L 8.0 47.25 Z M 249.0 47.25 L 339.0 47.25 L 339.0 86.75 L 249.0 86.75 Z",258.69,65.4],[3,2,6,"M 8.0 47.25 L 249.0 47.25 L 249.0 86.75 L 8.0 86.75 Z M 99.25 86.75 L 339.0 86.75 L 339.0 118.0 L 99.25 118.0 Z",109.09,99.8],[3,2,7,"M 8.0 86.75 L 99.25 86.75 L 99.25 118.0 L 8.0 118.0 Z M 8.0 118.0 L 339.0 118.0 L 339.0 151.75 L 8.0 151.75 Z",20.56,135.26],[3,2,8,"M 8.0 151.75 L 339.0 151.75 L 339.0 184.75 L 8.0 184.75 Z M 231.73 184.75 L 339.0 184.75 L 339.0 222.5 L 231.73 222.5 Z",240.88,205.55],[3,2,9,"M 8.0 184.75 L 231.73 184.75 L 231.73 222.5 L 8.0 222.5 Z M 89.74 222.5 L 339.0 222.5 L 339.0 257.0 L 89.74 257.0 Z",98.89,240.75],[3,2,10,"M 8.0 222.5